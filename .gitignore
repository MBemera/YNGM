# Local engine caches and generated build/test installations.
/game/.godot/
/build/
**/__pycache__/
*.pyc

# Downloaded tools, original asset archives and voice-model binaries.
/downloads/
/tools/godot/
/tools/nsis/
/tools/tts/venv/
/tools/tts/voices/*.onnx

# Failed trial captures and raw inputs; final take/video evidence is tracked.
/recordings/take-01/
/recordings/take-02/
/recordings/**/capture.mkv
/recordings/**/game-audio.wav

# Release packages are published as GitHub Release assets; sizes and hashes stay in dist/build-result.json.
/dist/*
!/dist/build-result.json

# Build logs hold local paths and are regenerated by every build.
/installer/*.log

# Local agent handoff notes.
/uptodate.md

# 2026-09-30 recording of the original Level-1 build, made before the fictional-name changes.
/recordings/take-03/

# Python test cache.
.pytest_cache/
